<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ResortSync.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ResortSync.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="PRPMS">

    <TabBar>
        <ShellContent
            Title="Bookings"
            ContentTemplate="{DataTemplate views:BookingsPage}"
            Route="bookings" />
        <ShellContent
            Title="Payments"
            ContentTemplate="{DataTemplate views:PaymentsPage}"
            Route="payments" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
