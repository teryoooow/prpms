<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ResortSync.Services;assembly=ResortSync.Core"
             x:Class="ResortSync.Mobile.Views.PaymentsPage"
             Title="Payments">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8" Padding="12">

        <!-- Search -->
        <SearchBar x:Name="SearchEntry"
                   Grid.Row="0"
                   Placeholder="Search guest, reference, or notes"
                   TextChanged="OnSearchTextChanged" />

        <!-- Method + type filters -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Picker x:Name="MethodPicker"
                    Grid.Column="0"
                    Title="Method"
                    SelectedIndexChanged="OnFilterChanged" />
            <Picker x:Name="TypePicker"
                    Grid.Column="1"
                    Title="Type"
                    SelectedIndexChanged="OnFilterChanged" />
        </Grid>

        <!-- Date range -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
            <Label Grid.Column="0"
                   FontSize="13"
                   TextColor="White"
                   VerticalOptions="Center"
                   Text="From" />
            <DatePicker x:Name="FromPicker"
                        Grid.Column="1"
                        DateSelected="OnFilterChanged" />
            <Label Grid.Column="2"
                   FontSize="13"
                   TextColor="White"
                   VerticalOptions="Center"
                   Text="To" />
            <DatePicker x:Name="ToPicker"
                        Grid.Column="3"
                        DateSelected="OnFilterChanged" />
        </Grid>

        <!-- Ledger -->
        <CollectionView x:Name="PaymentsList"
                        Grid.Row="3"
                        SelectionMode="None"
                        EmptyView="No payments match the current filters.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PaymentRow">
                    <Border Padding="12,10"
                            Margin="0,0,0,8"
                            StrokeThickness="1"
                            Stroke="#E0E0E0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#212121"
                                       LineBreakMode="TailTruncation"
                                       Text="{Binding GuestName}" />
                                <Label Grid.Column="1"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#00695C"
                                       Text="{Binding AmountPaid, StringFormat='₱{0:N2}'}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       FontSize="12"
                                       TextColor="#777777"
                                       Text="{Binding BookingId, StringFormat='#{0}'}" />
                                <Label Grid.Column="1"
                                       FontSize="12"
                                       TextColor="#555555"
                                       LineBreakMode="TailTruncation"
                                       Text="{Binding PaymentType}" />
                                <Label Grid.Column="2"
                                       FontSize="12"
                                       TextColor="#777777"
                                       Text="{Binding PaymentDate, StringFormat='{0:MMM dd, yyyy}'}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       FontSize="11"
                                       TextColor="#999999"
                                       Text="{Binding PaymentMethod}" />
                                <Label Grid.Column="1"
                                       FontSize="11"
                                       TextColor="#999999"
                                       LineBreakMode="TailTruncation"
                                       Text="{Binding ReferenceNumber}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Total -->
        <Label x:Name="TotalLabel"
               Grid.Row="4"
               FontSize="13"
               FontAttributes="Bold"
               TextColor="White"
               Text="0 transactions" />
    </Grid>
</ContentPage>
