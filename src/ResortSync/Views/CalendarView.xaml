<UserControl x:Class="ResortSync.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════════ HEADER ════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status legend -->
                <ItemsControl ItemsSource="{Binding Legend}"
                              Margin="0,0,14,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="9" Padding="9,4" Margin="0,0,6,0"
                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                    ToolTip="{Binding Hint}">
                                <TextBlock Text="{Binding Label}" Foreground="White"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Booking Calendar" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.65" />
            </StackPanel>
        </DockPanel>

        <!-- ════════════ MONTH NAVIGATION ════════════ -->
        <Border Grid.Row="1" Style="{StaticResource StatCard}" Margin="0,0,0,12" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Command="{Binding PreviousMonthCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="8,6" ToolTip="Previous month">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" />
                    </Button>

                    <TextBlock Text="{Binding MonthTitle}" FontSize="16" FontWeight="SemiBold"
                               MinWidth="170" TextAlignment="Center" Margin="12,0"
                               VerticalAlignment="Center" />

                    <Button Command="{Binding NextMonthCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="8,6" ToolTip="Next month">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" />
                    </Button>

                    <Button Content="Today" Command="{Binding GoTodayCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="14,7" Margin="14,0,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" Text="{Binding MonthSummary}"
                           FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ════════════ CALENDAR / SELECTED DAY ════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.4*" MinWidth="520" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.6*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ── Month grid ── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Weekday header -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Weekdays}" Margin="0,4,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                           FontSize="11.5" FontWeight="SemiBold" Opacity="0.6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Day cells -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectDayCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource MaterialDesignFlatButton}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="6,4" />
                                            <Setter Property="Margin" Value="2" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="VerticalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ClipToBounds" Value="True" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MaterialDesignPaper}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource MaterialDesignPrimary}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Day number -->
                                        <Border Grid.Row="0" Width="20" Height="20" CornerRadius="10"
                                                HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource MaterialDesignPrimary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DayNumber}" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasBookings}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Booking chips -->
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <ItemsControl ItemsSource="{Binding VisibleBookings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="5,2"
                                                                Margin="0,0,0,2"
                                                                Background="{Binding StatusColor, Converter={StaticResource StatusToBrush}}"
                                                                ToolTip="{Binding Tooltip}">
                                                            <TextBlock Text="{Binding GuestName}"
                                                                       Foreground="White" FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding OverflowLabel}"
                                                       FontSize="9.5" Opacity="0.7" Margin="2,1,0,0"
                                                       Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ── Selected day detail ── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1" CornerRadius="6" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Date header -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="SELECTED DATE" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedDayTitle}" FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDaySummary}" FontSize="12"
                                   Opacity="0.7" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Bookings on this date -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding SelectedDay.Bookings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="0,0,0,1" Padding="2,8" Margin="0,0,0,2"
                                            ToolTip="{Binding Tooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="8" Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            Background="{Binding StatusColor, Converter={StaticResource StatusToBrush}}">
                                                        <TextBlock Text="{Binding StatusGroup}"
                                                                   Foreground="White" FontSize="10"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding GuestName}"
                                                               FontWeight="SemiBold" FontSize="13.5"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock FontSize="11.5" Opacity="0.7" Margin="0,3,0,0">
                                                    <Run Text="{Binding DateRangeLabel, Mode=OneWay}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding StayLabel, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock FontSize="11.5" Opacity="0.75" Margin="0,2,0,0">
                                                    <Run Text="{Binding AmountLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" total • Booking #" />
                                                    <Run Text="{Binding BookingId, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Open" FontSize="12"
                                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Padding="12,6"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Command="{Binding DataContext.OpenBookingCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding BookingId}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty date -->
                    <TextBlock Grid.Row="2" Text="No bookings on this date."
                               FontStyle="Italic" FontSize="12.5" Opacity="0.6" Margin="0,14,0,0"
                               Visibility="{Binding SelectedDay.Bookings, Converter={StaticResource IsEmptyToVis}}" />

                    <!-- Nothing selected yet -->
                    <StackPanel Grid.Row="3" Margin="0,26,0,0" HorizontalAlignment="Center"
                                Opacity="0.55">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="CalendarBlank" Width="44" Height="44"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Select a date on the calendar"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="to see its bookings and status."
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
