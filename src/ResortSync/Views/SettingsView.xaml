<UserControl x:Class="ResortSync.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.65" Margin="0,0,0,4" />

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- ── Appearance ── -->
            <materialDesign:Card Padding="20,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="220" HorizontalAlignment="Left"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding Theme}" />
                    <TextBlock Text="“System” follows the Windows light/dark preference."
                               FontSize="11" Opacity="0.55" Margin="0,6,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- ── Resort identity ── -->
            <materialDesign:Card Padding="20,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="RESORT IDENTITY" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Resort name (printed on receipts)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ResortName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Seaside Paradise Resort" />
                </StackPanel>
            </materialDesign:Card>

            <!-- ── Booking defaults ── -->
            <materialDesign:Card Padding="20,18">
                <StackPanel>
                    <TextBlock Text="BOOKING &amp; PAYMENT DEFAULTS" Style="{StaticResource SectionTitle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Required downpayment (% of total)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DownpaymentPercent, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="50" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Default price per extra guest ₱" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DefaultExtraGuestRate, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="300" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" MaxWidth="240" HorizontalAlignment="Left">
                        <TextBlock Text="Default base guests" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DefaultBaseGuests, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="2" />
                    </StackPanel>

                    <TextBlock Text="Applies to bookings created from now on; existing bookings keep their snapshot amounts."
                               FontSize="11" Opacity="0.55" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <Button Content="Save Settings"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Right"
                            Padding="22,9" Margin="0,16,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- ── About ── -->
            <Border Margin="0,16,0,0" Opacity="0.55">
                <StackPanel>
                    <TextBlock Text="PRPMS v1.0 — Private Resort Payment Monitoring System"
                               FontSize="11" />
                    <TextBlock Text="Database: %LocalAppData%\ResortSync\resortsync.db  •  Auto-expiry worker: every 60 seconds"
                               FontSize="11" />
                    <TextBlock Text="Created by Terelle Sarmiento"
                               FontSize="11" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
