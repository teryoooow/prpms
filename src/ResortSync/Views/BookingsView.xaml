<UserControl x:Class="ResortSync.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <Grid>

        <!-- ════════════ HEADER ════════════ -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New Booking"
                        Command="{Binding NewBookingCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="16,8" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="All Bookings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.65" />
            </StackPanel>
        </DockPanel>

        <!-- ════════════ FILTER BAR ════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource StatCard}" Margin="0,0,0,12" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Status" VerticalAlignment="Center" FontSize="12"
                               Opacity="0.7" Margin="0,0,8,0" />
                    <ComboBox Width="170"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                    <Button Content="Refresh" Margin="12,0,0,0" Padding="12,7"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>

                <TextBox Width="320"
                         materialDesign:HintAssist.Hint="Search guest, phone, or booking #"
                         materialDesign:HintAssist.IsFloating="False"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <!-- ════════════ MASTER / DETAIL ════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ── Bookings grid ── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1" CornerRadius="6" Padding="4">
                <DataGrid ItemsSource="{Binding Bookings}"
                          SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="40" FontSize="13"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Width="55"
                                            Binding="{Binding Id}" />
                        <DataGridTextColumn Header="Guest" Width="*"
                                            Binding="{Binding Guest.FullName}" />
                        <DataGridTextColumn Header="Check-in" Width="105"
                                            Binding="{Binding CheckInDate, StringFormat='MMM dd, yyyy'}" />
                        <DataGridTextColumn Header="Type" Width="120"
                                            Binding="{Binding StayLabel}" />
                        <DataGridTextColumn Header="Total" Width="95"
                                            Binding="{Binding TotalAmount, StringFormat='₱{0:N2}'}" />
                        <DataGridTextColumn Header="Paid" Width="95"
                                            Binding="{Binding PaidAmount, StringFormat='₱{0:N2}'}" />
                        <DataGridTextColumn Header="Balance" Width="95"
                                            Binding="{Binding RemainingBalance, StringFormat='₱{0:N2}'}" />
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,3" HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                   Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Detail pane ── -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                <StackPanel>

                    <!-- Booking identity -->
                    <materialDesign:Card Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right"
                                        Background="{Binding Detail.Status, Converter={StaticResource StatusToBrush}}"
                                        CornerRadius="9" Padding="10,4">
                                    <TextBlock Text="{Binding Detail.Status}" Foreground="White"
                                               FontSize="11.5" FontWeight="Bold" />
                                </Border>
                                <TextBlock FontSize="19" FontWeight="Bold">
                                    <Run Text="Booking" /><Run Text="#" />
                                    <Run Text="{Binding Detail.Id, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>

                            <TextBlock Margin="0,8,0,0" FontSize="14">
                                <Run Text="{Binding Detail.Guest.FullName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="12" Opacity="0.7">
                                <Run Text="Tel:" /><Run Text="{Binding Detail.Guest.Phone, Mode=OneWay}" />
                                <Run Text="  •  Email: " /><Run Text="{Binding Detail.Guest.Email, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.75">
                                <Run Text="{Binding Detail.StayLabel, Mode=OneWay}" />
                                <Run Text="  •  " />
                                <Run Text="{Binding Detail.CheckInDate, Mode=OneWay, StringFormat='MMM dd, yyyy'}" />
                                <Run Text="→" />
                                <Run Text="{Binding Detail.CheckOutDate, Mode=OneWay, StringFormat='MMM dd, yyyy'}" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.75"
                                       Text="{Binding Detail.Notes}" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Money -->
                    <materialDesign:Card Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BALANCE" Style="{StaticResource SectionTitle}" />
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="Total" FontSize="11" Opacity="0.6" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold"
                                               Text="{Binding Detail.TotalAmount, Converter={StaticResource Currency}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Paid" FontSize="11" Opacity="0.6" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#43A047"
                                               Text="{Binding DetailPaid, Converter={StaticResource Currency}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Remaining" FontSize="11" Opacity="0.6" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#EF5350" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail.RemainingBalance}" Value="0">
                                                        <Setter Property="Foreground" Value="#43A047" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Detail.RemainingBalance, Mode=OneWay, Converter={StaticResource Currency}}" />
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Margin="0,8,0,0" FontSize="11.5" Opacity="0.65"
                                       Text="{Binding Detail.DepositDeadline,
                                                      StringFormat=Deposit deadline: {0:MMM dd, yyyy hh:mm tt}}" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Actions -->
                    <materialDesign:Card Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ACTIONS" Style="{StaticResource SectionTitle}" />
                            <WrapPanel>
                                <Button Content="Record Payment"
                                        Command="{Binding RecordPaymentCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="Print Receipt"
                                        Command="{Binding PrintReceiptCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="Edit"
                                        Command="{Binding EditBookingCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="Mark Completed"
                                        Command="{Binding MarkCompletedCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="Cancel Booking"
                                        Command="{Binding CancelBookingCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="Reopen (new 24h window)"
                                        Command="{Binding ReopenBookingCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="10,8" Margin="0,0,8,8" FontSize="12" />
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Payments -->
                    <materialDesign:Card Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="PAYMENTS" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="No payments recorded yet."
                                       FontStyle="Italic" FontSize="12.5" Opacity="0.6"
                                       Visibility="{Binding DetailPayments, Converter={StaticResource IsEmptyToVis}}" />

                            <DataGrid ItemsSource="{Binding DetailPayments}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" RowHeight="36" FontSize="12.5"
                                      MaxHeight="320"
                                      Style="{StaticResource MaterialDesignDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Width="140"
                                                        Binding="{Binding PaymentDate, StringFormat='MMM dd, hh:mm tt'}" />
                                    <DataGridTextColumn Header="Type" Width="110"
                                                        Binding="{Binding PaymentType}" />
                                    <DataGridTextColumn Header="Method" Width="105"
                                                        Binding="{Binding PaymentMethod}" />
                                    <DataGridTextColumn Header="Ref #" Width="110"
                                                        Binding="{Binding ReferenceNumber}" />
                                    <DataGridTextColumn Header="Amount" Width="95"
                                                        Binding="{Binding AmountPaid, StringFormat='₱{0:N2}'}" />
                                    <DataGridTemplateColumn Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Void" FontSize="11" Padding="8,3"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.VoidPaymentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- Empty state -->
            <Border Grid.Column="2" Visibility="{Binding HasDetail, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.55">
                    <materialDesign:PackIcon Kind="ArrowLeftBoldCircleOutline" Width="48" Height="48"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="Select a booking to see its details,"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="payments, and receipt options."
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
