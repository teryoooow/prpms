<UserControl x:Class="ResortSync.Views.BookingFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1080">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ════════════ LEFT COLUMN ════════════ -->
            <StackPanel Grid.Column="0">

                <!-- Page header -->
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Back to Dashboard"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="12,7" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                </DockPanel>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <!-- ── Guest card ── -->
                <materialDesign:Card Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="GUEST" Style="{StaticResource SectionTitle}" />

                        <!-- Returning-guest search -->
                        <TextBlock Text="Search returning guest (name, phone, email, ID)"
                                   Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox materialDesign:HintAssist.Hint="e.g. Dela Cruz / 0917..."
                                     Text="{Binding GuestSearchQuery, UpdateSourceTrigger=PropertyChanged}">
                                <behavior:Interaction.Triggers>
                                    <behavior:EventTrigger EventName="TextChanged">
                                        <behavior:InvokeCommandAction Command="{Binding SearchGuestsCommand}" />
                                    </behavior:EventTrigger>
                                </behavior:Interaction.Triggers>
                            </TextBox>

                            <Button Grid.Column="1" Content="Clear" Margin="8,0,0,0"
                                    Padding="10,6" FontSize="12"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ClearGuestCommand}" />
                        </Grid>

                        <!-- Autocomplete suggestions -->
                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1" CornerRadius="4"
                                Margin="0,4,0,0" Padding="0,4"
                                Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVis}}">
                            <ListBox ItemsSource="{Binding GuestSuggestions}"
                                     MaxHeight="170" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,5">
                                            <StackPanel.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.PickGuestCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </StackPanel.InputBindings>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountOutline" Width="15" Height="15"
                                                                         VerticalAlignment="Center" Opacity="0.7" />
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock FontSize="11" Opacity="0.6">
                                                <Run Text="{Binding Phone, Mode=OneWay}" />
                                                <Run Text="•" />
                                                <Run Text="{Binding Email, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Editable guest fields -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Full name *" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GuestFullName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Juan Dela Cruz" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Mobile number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GuestPhone, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="09XXXXXXXXX" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GuestEmail, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="juan@email.com" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ID type / Number" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="140"
                                             Text="{Binding GuestIdNumber, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="1234-5678" />
                                    <TextBox Text="{Binding GuestIdType, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="National ID" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GuestNotes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                                         materialDesign:HintAssist.Hint="VIP, birthday, special requests..." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ── Stay card ── -->
                <materialDesign:Card Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="STAY DETAILS" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Check-in *" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding CheckInDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Check-out *" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding CheckOutDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Stay type" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding StayTypes}"
                                          SelectedItem="{Binding StayType}" />
                            </StackPanel>
                        </Grid>

                        <!-- Double-booking protection -->
                        <TextBlock Text="{Binding ConflictMessage}"
                                   Style="{StaticResource ErrorText}"
                                   Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <!-- ════════════ RIGHT COLUMN ════════════ -->
            <StackPanel Grid.Column="2">

                <!-- ── Pricing inputs ── -->
                <materialDesign:Card Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PRICING" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Base amount ₱ (package / room rate)"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BaseAmount, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="0.00" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Base guests (included)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BaseGuests, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="2" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Additional guests" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AdditionalGuests, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Price per extra guest ₱" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding PricePerExtraGuest, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="0.00" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ── Add-ons ── -->
                <materialDesign:Card Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ADD-ONS" Style="{StaticResource SectionTitle}" />

                        <ItemsControl ItemsSource="{Binding Addons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected}" />

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                            <TextBlock Text="{Binding PriceLabel}" FontSize="10.5" Opacity="0.6" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="Qty"
                                                   FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />

                                        <TextBox Grid.Column="3"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsSelected}"
                                                 HorizontalContentAlignment="Center" />

                                        <TextBlock Grid.Column="4" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                            <Setter Property="Opacity" Value="0.35" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding Quantity, Mode=OneWay}" />
                                            <Run Text="×" />
                                            <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:N2}}" />
                                            <Run Text="=" />
                                            <Run Text="{Binding LineTotal, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No add-ons selected."
                                   Opacity="0.5" FontStyle="Italic" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding Addons, Converter={StaticResource IsEmptyToVis}}" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- ── Live total / deposit summary ── -->
                <materialDesign:Card Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="PAYMENT SUMMARY" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Extra guests charge" Opacity="0.75" FontSize="13" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13"
                                       Text="{Binding ExtraGuestCharge, Converter={StaticResource Currency}}" />

                            <TextBlock Grid.Row="2" Text="Add-ons total" Opacity="0.75" FontSize="13" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13"
                                       Text="{Binding AddonsTotal, Converter={StaticResource Currency}}" />

                            <TextBlock Grid.Row="4" Text="Base amount" Opacity="0.75" FontSize="13" />
                            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="13"
                                       Text="{Binding BaseAmount, Converter={StaticResource Currency}}" />

                            <Separator Grid.Row="6" />

                            <TextBlock Grid.Row="8" Text="TOTAL AMOUNT"
                                       FontWeight="Bold" FontSize="16" />
                            <TextBlock Grid.Row="8" Grid.Column="1"
                                       FontWeight="Bold" FontSize="16"
                                       Text="{Binding TotalAmount, Converter={StaticResource Currency}}" />

                            <TextBlock Grid.Row="10"
                                       Text="{Binding DepositPercentLabel}"
                                       Foreground="{DynamicResource MaterialDesignPrimary}"
                                       FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Grid.Row="10" Grid.Column="1"
                                       Foreground="{DynamicResource MaterialDesignPrimary}"
                                       FontWeight="SemiBold" FontSize="13.5"
                                       Text="{Binding DepositRequired, Converter={StaticResource Currency}}" />
                        </Grid>

                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Remaining balance after deposit"
                                           FontSize="13" Opacity="0.8" VerticalAlignment="Center" />
                                <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Text="{Binding RemainingBalance, Converter={StaticResource Currency}}" />
                            </DockPanel>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="18,9" Margin="0,0,10,0" />
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="22,9"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    Command="{Binding SaveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18"
                                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Save Booking" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
