<Window x:Class="ResortSync.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Payment Receipt"
        Width="820" Height="900"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="16,10"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding PrintCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="18,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Print" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Close" Click="OnCloseClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="18,8" />
                </StackPanel>
                <TextBlock Text="Receipt preview" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Printable document -->
        <Border Grid.Row="1" Margin="16" Padding="8"
                Background="White"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1" CornerRadius="4">
            <FlowDocumentScrollViewer VerticalScrollBarVisibility="Auto"
                                      Document="{Binding Document}" />
        </Border>
    </Grid>
</Window>
