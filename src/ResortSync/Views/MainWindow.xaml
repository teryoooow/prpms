<Window x:Class="ResortSync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PRPMS — Private Resort Payment Monitoring System"
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ResortSync.ViewModels"
        mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════ NAVIGATION DRAWER ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Waves"
                                                 Width="30" Height="30"
                                                 Foreground="{DynamicResource MaterialDesignPrimary}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="PRPMS"
                                   FontSize="23" FontWeight="Bold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Private Resort Payment Monitoring System"
                               FontSize="11" Opacity="0.6" Margin="2,4,0,0" />
                </StackPanel>

                <!-- Nav items -->
                <ListBox x:Name="NavList"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="8,0,8,8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="14,12" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                         Width="20" Height="20"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           Margin="14,0,0,0"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="20,0,20,16"
                           FontSize="10.5" Opacity="0.55"
                           TextWrapping="Wrap"
                           Text="Local SQLite • Auto-expiry ON • v1.0" />
            </DockPanel>
        </Border>

        <!-- ══════════════ CONTENT COLUMN ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- App bar -->
            <Border Grid.Row="0"
                    Padding="24,14"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding CurrentViewModel.Title}"
                               FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" Opacity="0.65"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center" />
                        <Button Content="Home"
                                Command="{Binding GoHomeCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="12,6" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page content (swapped by DataTemplates in App.xaml) -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="24,18,24,8"
                            Focusable="False" />

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Padding="24,7"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusMessage}"
                               FontSize="11" Opacity="0.6" />
                    <TextBlock DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               FontSize="11" Opacity="0.6"
                               Text="Local database: %LocalAppData%\ResortSync\resortsync.db" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
