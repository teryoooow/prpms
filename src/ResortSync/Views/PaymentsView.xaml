<UserControl x:Class="ResortSync.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════════ HEADER ════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Export CSV"
                        Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="14,8" Margin="0,0,10,0" />
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Payments" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.65" />
            </StackPanel>
        </DockPanel>

        <!-- ════════════ FILTERS ════════════ -->
        <Border Grid.Row="1" Style="{StaticResource StatCard}" Margin="0,0,0,12" Padding="14,10">
            <WrapPanel>
                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="Search (guest, ref #, booking)" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="240"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="e.g. GCash123 / Dela Cruz" />
                </StackPanel>

                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="Method" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="150"
                              ItemsSource="{Binding MethodFilters}"
                              SelectedItem="{Binding SelectedMethodFilter}" />
                </StackPanel>

                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding TypeFilters}"
                              SelectedItem="{Binding SelectedTypeFilter}" />
                </StackPanel>

                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="140" SelectedDate="{Binding FromDate}" />
                </StackPanel>

                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="To (inclusive)" Style="{StaticResource FieldLabel}" />
                    <DatePicker Width="140" SelectedDate="{Binding ToDate}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ════════════ LEDGER ════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1" CornerRadius="6" Padding="4">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="13.5"
                                   VerticalAlignment="Center">
                            <Run Text="Shown net total: " />
                            <Run Text="{Binding VisibleTotal, Mode=OneWay, Converter={StaticResource Currency}}" />
                        </TextBlock>
                        <TextBlock Text="Left: Open booking  •  Click a row, then use All Bookings for actions."
                                   FontSize="11.5" Opacity="0.55" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <DataGrid x:Name="PaymentsGrid"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="38" FontSize="13"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenBookingCommand}"
                                      CommandParameter="{Binding SelectedItem, ElementName=PaymentsGrid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Width="150"
                                            Binding="{Binding PaymentDate, StringFormat='MMM dd, yyyy hh:mm tt'}" />
                        <DataGridTextColumn Header="Booking" Width="80"
                                            Binding="{Binding BookingId, StringFormat='#{0}'}" />
                        <DataGridTextColumn Header="Guest" Width="*"
                                            Binding="{Binding GuestName}" />
                        <DataGridTextColumn Header="Type" Width="120"
                                            Binding="{Binding PaymentType}" />
                        <DataGridTextColumn Header="Method" Width="115"
                                            Binding="{Binding PaymentMethod}" />
                        <DataGridTextColumn Header="Reference #" Width="150"
                                            Binding="{Binding ReferenceNumber}" />
                        <DataGridTextColumn Header="Amount" Width="110"
                                            Binding="{Binding AmountPaid, StringFormat='₱{0:N2}'}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
