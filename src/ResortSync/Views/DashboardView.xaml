<UserControl x:Class="ResortSync.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ── Page header ── -->
            <DockPanel Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="New Booking"
                            Command="{Binding NewBookingCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="16,8" Margin="0,0,10,0" />
                    <Button Command="{Binding ReloadCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.65" />
                </StackPanel>
            </DockPanel>

            <!-- Busy indicator -->
            <ProgressBar IsIndeterminate="True"
                         Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- ── Stat cards ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Monthly revenue -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22"
                                                     Foreground="{DynamicResource MaterialDesignPrimary}" />
                            <TextBlock Text="Monthly Revenue" Style="{StaticResource StatCaption}"
                                       Margin="8,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding MonthlyRevenue, Converter={StaticResource Currency}}"
                                   Style="{StaticResource StatValue}" />
                        <TextBlock Text="downpayments + settlements this month"
                                   FontSize="10.5" Opacity="0.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Pending balances -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="WalletOutline" Width="22" Height="22"
                                                     Foreground="{DynamicResource MaterialDesignSecondary}" />
                            <TextBlock Text="Balances to Collect" Style="{StaticResource StatCaption}"
                                       Margin="8,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding PendingBalanceTotal, Converter={StaticResource Currency}}"
                                   Style="{StaticResource StatValue}" />
                        <Button Content="View payments ledger"
                                Command="{Binding ViewPaymentsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Left"
                                Padding="0" Margin="0,6,0,0" FontSize="11.5" />
                    </StackPanel>
                </Border>

                <!-- Today's check-ins -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Login" Width="22" Height="22"
                                                     Foreground="{DynamicResource MaterialDesignPrimary}" />
                            <TextBlock Text="Today's Check-ins" Style="{StaticResource StatCaption}"
                                       Margin="8,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding TodayCheckIns}" Style="{StaticResource StatValue}" />
                        <TextBlock FontSize="10.5" Opacity="0.5" Margin="0,4,0,0">
                            <Run Text="{Binding ActiveBookings, Mode=OneWay}" />
                            <Run Text="active booking(s)" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Overdue downpayments -->
                <Border Grid.Column="3" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockAlertOutline" Width="22" Height="22"
                                                     Foreground="#EF5350" />
                            <TextBlock Text="Overdue Downpayments" Style="{StaticResource StatCaption}"
                                       Margin="8,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding OverdueDownpayments}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverdueDownpayments}" Value="0">
                                            <Setter Property="Foreground" Value="#43A047" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="24-hour deposit window breached"
                                   FontSize="10.5" Opacity="0.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Live deposit alerts ── -->
            <Border Style="{StaticResource StatCard}" Margin="0,4,0,12" Padding="20,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="BellRingOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource MaterialDesignSecondary}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="Downpayment Alerts — expiring or expired (24-hour window)"
                                   Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                    </DockPanel>

                    <!-- Empty state -->
                    <TextBlock Text="No downpayment alerts. All pending bookings are within their window."
                               Opacity="0.55" FontStyle="Italic" FontSize="12.5"
                               Visibility="{Binding DepositAlerts, Converter={StaticResource IsEmptyToVis}}" />

                    <!-- Alerts -->
                    <ListView ItemsSource="{Binding DepositAlerts}"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,10" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Booking"
                                                Width="90"
                                                DisplayMemberBinding="{Binding Id, StringFormat=#{0}}" />
                                <GridViewColumn Header="Guest" Width="200"
                                                DisplayMemberBinding="{Binding Guest.FullName}" />
                                <GridViewColumn Header="Check-in" Width="130"
                                                DisplayMemberBinding="{Binding CheckInDate, StringFormat='MMM dd, yyyy'}" />
                                <GridViewColumn Header="Stay" Width="140"
                                                DisplayMemberBinding="{Binding StayLabel}" />
                                <GridViewColumn Header="Deposit Due" Width="110"
                                                DisplayMemberBinding="{Binding DepositRequired, StringFormat=₱{0:N2}}" />
                                <GridViewColumn Header="Deadline" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                       Text="{Binding DepositDeadline, Converter={StaticResource DeadlineLabel}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDepositOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="#EF5350" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDepositExpiringSoon}" Value="True">
                                                                <Setter Property="Foreground" Value="#FB8C00" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Handle →"
                                                    Padding="10,4" FontSize="12"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Command="{Binding DataContext.OpenAlertCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
